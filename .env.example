# Copy to .env and adjust as needed.

# Port the app is reachable on at http://localhost:PORT
PORT=3000

# Which host interface the port binds to. Localhost-only by default since
# there's no login/auth on the app itself — set to 0.0.0.0 to make it
# reachable from other devices on your LAN (e.g. http://<host-ip>:PORT).
BIND_ADDR=127.0.0.1

# Where your markdown vault lives on the host (journals/, pages/, assets/).
# Defaults to ./vault inside this project — put it here if you'd rather point
# at an existing synced folder.
VAULT_HOST_PATH=./vault

# On Linux, set these to your host user's uid/gid (run `id -u` / `id -g`) so
# files written into the vault are owned by you, not root. macOS Docker Desktop
# doesn't need this — the defaults are harmless there.
PUID=1000
PGID=1000

# Your IANA timezone name — required so "today" in Journals matches your local
# date instead of UTC. Find yours with:
#   macOS:  readlink /etc/localtime | sed 's|.*/zoneinfo/||'
#   Linux:  cat /etc/timezone
TZ=UTC

# Optional: a LanguageTool server's base URL (self-hosted or the public API)
# for spell/grammar checking in the block editor. Leave unset to disable the
# feature entirely — nothing is sent to any external service unless this is
# explicitly configured. Include the version path but not a trailing slash,
# e.g. https://languagetool.example.com/v2
LANGUAGETOOL_URL=
LANGUAGETOOL_LANGUAGE=en-US
